# Copy to .env (gitignored) before running Compose: cp .env.example .env
# Local development values only. Change the password if you expose the port beyond your machine.

POSTGRES_USER=labpipe
POSTGRES_PASSWORD=labpipe
POSTGRES_DB=labpipe

# Port Postgres is published on, on your machine. Change it if 5432 is taken.
POSTGRES_PORT=5432
